{
  "name": "back-in-claude",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "probe": "node src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "~0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
