{
  "name": "back-in-claude",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm test",
    "probe": "node src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "~0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
